        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1015" ANNOTATION_REF="a430">
                <ANNOTATION_VALUE>nimir š-ird-a ab-us-ke ama mīn-am-r-i ya abu ḥasan,</ANNOTATION_VALUE>
