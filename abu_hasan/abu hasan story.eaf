        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1099" ANNOTATION_REF="a472">
                <ANNOTATION_VALUE>fē-r-a abu ḥasan-as-ke ila-hu qtaʕka-d-ēk danab-is dawāy-ki.</ANNOTATION_VALUE>
