        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1005" ANNOTATION_REF="a425">
                <ANNOTATION_VALUE>ū ē-r-a ḥāris-ke,</ANNOTATION_VALUE>
