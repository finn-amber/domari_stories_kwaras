        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1067" ANNOTATION_REF="a456">
                <ANNOTATION_VALUE>e-h-r-a bara arat-i</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1069" ANNOTATION_REF="a457">
                <ANNOTATION_VALUE>sit-e ʕind šāl-as-ki</ANNOTATION_VALUE>
