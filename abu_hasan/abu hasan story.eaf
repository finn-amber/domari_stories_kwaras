        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a987" ANNOTATION_REF="a416">
                <ANNOTATION_VALUE>abu ḥasan ga-r-a min hnona,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a989" ANNOTATION_REF="a417">
                <ANNOTATION_VALUE>nimer gēna ga-r-a min hnon.</ANNOTATION_VALUE>
