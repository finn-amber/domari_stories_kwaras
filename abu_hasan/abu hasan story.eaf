            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a995" ANNOTATION_REF="a420">
                <ANNOTATION_VALUE>nadi-k-ad-a ū giš ahal-os ē-r-e.</ANNOTATION_VALUE>
