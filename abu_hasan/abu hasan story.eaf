        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1045" ANNOTATION_REF="a445">
                <ANNOTATION_VALUE>ū č-ird-a nimir-ki wēštī bṣāṭ-ē-ka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1047" ANNOTATION_REF="a446">
                <ANNOTATION_VALUE>ila-hu nimer kw-ir-a šāł-as-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1049" ANNOTATION_REF="a447">
