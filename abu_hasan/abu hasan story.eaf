        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1065" ANNOTATION_REF="a455">
                <ANNOTATION_VALUE>lak-ed-a šał-as,</ANNOTATION_VALUE>
