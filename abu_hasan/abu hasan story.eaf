        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1011" ANNOTATION_REF="a428">
                <ANNOTATION_VALUE>ū pēn-d-a giš danab-ē-san.</ANNOTATION_VALUE>
