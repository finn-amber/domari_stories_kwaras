        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1001" ANNOTATION_REF="a423">
                <ANNOTATION_VALUE>waqt-ma itme qās-i ama bidd-ī ban-am danab-ē-ran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1003" ANNOTATION_REF="a424">
