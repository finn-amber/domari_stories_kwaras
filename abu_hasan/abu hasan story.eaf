        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1135" ANNOTATION_REF="a490">
                <ANNOTATION_VALUE>kadždži xl-aw-ird-i gar-ya,</ANNOTATION_VALUE>
