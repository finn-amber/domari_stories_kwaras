        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1103" ANNOTATION_REF="a474">
                <ANNOTATION_VALUE>lak-ed-a ʕaṣfur-i sit-ik pandži ū putr-ē-s.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1105" ANNOTATION_REF="a475">
                <ANNOTATION_VALUE>ē-r-a qumn-ar putr-ē-s ʕaṣfur-ki.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1107" ANNOTATION_REF="a476">
                <ANNOTATION_VALUE>na qumna putr-ē-m!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1109" ANNOTATION_REF="a477">
                <ANNOTATION_VALUE>abu ḥasan š-ird-a ab-us-ke: xiz-aw-ē-m!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1111" ANNOTATION_REF="a478">
                <ANNOTATION_VALUE>ʕaṣfur š-ar-i ab-us-ke keh-ni?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1113" ANNOTATION_REF="a479">
                <ANNOTATION_VALUE>ašti maṭ-ēni qṭuf-k-ad-i min zaraʕ-ki</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1115" ANNOTATION_REF="a480">
                <ANNOTATION_VALUE>ʕasfura š-ird-a ab-us-ke ṭayyib, wēšt-ī, stanno-hō-š-i!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1117" ANNOTATION_REF="a481">
                <ANNOTATION_VALUE>ʕaṣfura ṭīra-h-r-i mind-ird-i siry-is-ka ik-ak min illi qṭuf-k-ad-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1119" ANNOTATION_REF="a482">
                <ANNOTATION_VALUE>ila-hu ē-r-ēk kažž-ak-i hēy-ma sēf-as-ma bidd-o šn-ar siry-is ʕaṣfur-ki.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1121" ANNOTATION_REF="a483">
                <ANNOTATION_VALUE>š-ind-a siry-os kažž-as-ki,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1123" ANNOTATION_REF="a484">
                <ANNOTATION_VALUE>abu ḥasan xaz-r-a bsuṭa-h-r-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1125" ANNOTATION_REF="a485">
                <ANNOTATION_VALUE>kān bidd-o qumn-ar putr-ē-s ʕaṣfur-ēk-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1127" ANNOTATION_REF="a486">
                <ANNOTATION_VALUE>č-ird-a ab-us-ke karwas-ir kē bidd-ak?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1129" ANNOTATION_REF="a487">
                <ANNOTATION_VALUE>ama tirsala-h-r-om-i, bidd-ī py-am.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1131" ANNOTATION_REF="a488">
                <ANNOTATION_VALUE>ama bidd-ī py-am illi mīnd-os ihi kadždž-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1133" ANNOTATION_REF="a489">
                <ANNOTATION_VALUE>ʕaṣfur mind-ird-a agir kadždž-ak-i,</ANNOTATION_VALUE>
