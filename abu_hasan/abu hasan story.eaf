        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1101" ANNOTATION_REF="a473">
                <ANNOTATION_VALUE>abu ḥasan nas-r-a.</ANNOTATION_VALUE>
