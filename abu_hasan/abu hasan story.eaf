                <ANNOTATION_VALUE>àbu ḥàsàn</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a589" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>nàdi-k-erd-a qàum-ē-s giš. qàrw xàr-an, mīn-d-e ḥàl-ēsan u ga-r-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a591" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>nàu-r-a abū ḥasan, lah-erd-a fŭrw-ēk</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a593" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>(u) t-ird-ōs-is pal-ē-s-tà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a595" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>ning-r-a ē mŭɣar-ē-mà</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a597" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>lah-erd-a bàr-ūs nimr-às-ki mŭɣar-ē-mà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a599" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>mīn-d-ōs-is nimr, qàl:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a601" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>àbu ḥasan, kē-ka mar-d-ōr bàr-ōm?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a603" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>ama nī ḥ-r-ōm-i gōrw-i</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a605" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>àtū illi ik-t-ōr fasàdi</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a607" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>lah-erd-a nimr fūrw-ē pal-ē-s-t-ik;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a609" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>kàl: àbū ḥasan, ke-r-ēk amà-ka yik-àk miθl àur-ak-i?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a611" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>rūd-r-a abū ḥasan: ker-am-i:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a613" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>nan amà-ka št-àr bakra gar-d-a,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a615" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>mar-ē-san,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a617" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>ta-ker-am ab-ŭr-kara fūrw-ek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a619" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs nimr, nan-d-a ab-ŭs-karà št-àr bakra.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a621" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>qa r-a màsy-an,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a623" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>u kta qàl-an čàl-as-ma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a627" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>a-r-a nimr ab-ŭs-kara, kàl: kà fūrwē, abū ḥasan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a629" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>qàl: màng-ar-i bakr-ak gēna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a631" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>nan-d-a ab-ŭs-kara nimr bakr-ak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a633" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>mar-d-os-is, qār-d-os-is àbū ḥasan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a635" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>( qār-d-os-is )</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a637" ANNOTATION_REF="a75">
                <ANNOTATION_VALUE>pàndžī u potr-ē-s,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a639" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>u kta qàl-as čàl-as-m-a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>a-r-a ab-ŭs-kara nimr.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a643" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>kà fūrwē, abū hasan?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a645" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>qàl: wind-ir ta nan-am-is.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a647" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>nas-r-a abū ḥasan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a649" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>ras-r-ōs nimr</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a651" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs, ga-r-a, ning-ar-i ēmŭɣar-ē-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a653" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>mīn-d-ōs-is nimr dhanab-us-ki;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a655" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>intà-k-erd-a ḥàl-ōs abū ḥasan,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a657" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>intà-k-erd-a ḥàl-ō-s abū ḥasan, čn-ī-r-a dhanab-os nimr-as xast-às-ma.št-ird-a min hnōnà abū ḥasan, man-d-a ʕazar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a659" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>č-ird-a nimr abus-kà, qàl: atū, abu ḥasan ʕazar-ḥ-r-ōr,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a661" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>džan-d-ōm-ur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a663" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>ga-r-a min hnōna abū ḥasan,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a665" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>rawàḥ-r-a nimr.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a667" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>ga-r-a e karm-as-ka, q-ar-a ʕanab min mnēš-īs.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a669" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>( qa-r-à ʕanab )</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a671" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>fē-r-a sōṭ-ak, giš džamʕat-ē-s a-r-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a673" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>qumn-an idr-ak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a675" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>xl-àur-d-ōs-san e karm-as-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a677" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>qàl: man-im-r-aneʔ qumn-as ɣàir ta mban-im pindžik-ē-ran.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a679" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>ban-d-ōs-san abū ḥasan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a681" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>u a-r-a naṭr-as-kara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a683" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>sawuṭ-kē-r-d-à kan-is-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a685" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>št-ird-a min hnōna ŭhŭ naṭūr fē-r-ōs-san dfàng-ma winni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a687" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>giš dhanab-ē-san kàn-ī-r-ēnd-i</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a689" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs abū ḥasan, ga-r-a nimr-as-ka;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a691" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>qàl: mīn-d-ōm-ir, abū ḥasan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a693" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>qàl: kà k-r-ēk mindžīm, yà zelam-i?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a695" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>qàl: atu par-d-ōr bak-ran u qā-r-ōs-san,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a697" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>nī ke-rd-ōr fūrwē ama-kara.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a699" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>qàl: ama nī-h-r-ōm-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a701" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>qàl: atū-h-r-ūr-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a703" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>qàl: kē-i džan-àur-d-ōs-ir inn-i ama h-r-ōm-i?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a705" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>qàl: ama č-ind-ōm dhanab-ūr.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a707" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>qàl: giš džamaʕt-ē-m qàrib-e-m ʕasarn-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a709" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>qàl: lah-amn-i: nàdi-ker-ē-san.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a711" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>fē-r-e at-sàn-ta sōṭ-ak abū ḥasan,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a713" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>giš a-r-e; lah-erd-ōs-san nimr giš ʕazarn-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a715" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>nī dž-and-a kōn-ik illi q-ar-a bakr-an.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a717" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs abī ḥàsan, ʔàzim-k-erd-a nimr-as.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a719" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>tīr-d-a ḥassīr-i čàl-as-ka pya-ta abu ḥasan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a721" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>wēšl-àur-d-a nimr-as at-us-ta,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a723" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>winni ku-i-r-ek čàl-as mandž-is-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a725" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>a-r-a min hnōnà.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a727" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>šib-r-a nimr min čàl-as-ki winni</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a729" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>mīn-d-ēk abu ḥasan-as u tīr-d-ōs-is čàl-as-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a731" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>ḥ-r-e diyēn-i čàl-as-m-a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a733" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs nimr, dī dīs ibkarwài-àn-ki m-r-à.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a735" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>qà-r-a abū ḥasan nimr-as čàl-as-m-a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a737" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>ašte kadždži-ēni ā-r-end-i ta kun-and čmary-an.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a739" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>bard-ēni slàl-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a741" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>lah-erd-e e čal-as.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a743" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>ɣēb-r-i at-sàn-ta gam.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a745" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>sit-e čàl-as-ta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a747" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>delli-k-erd-e čmàry-an čàl-as-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a749" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>sl-àur-d-ēnd-san čàl-as-m-a aratīy-ōs;</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a751" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>abu ḥàsan nī man-d-a mnēš-san wala čmary-ak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a753" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>sabàḥtan inšil-kēr-d-e kadždži-e sell-as min čàl-as-ki</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a755" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>pàndžī site-k sell-as-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a757" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>yōmin kil-d-a båra, nas-r-a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a759" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>a-r-e kadždži-e, ro-r-e</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a761" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>u gār-ī-r-e rawàḥ-r-e kuri-ē-san-ta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a763" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>mīn-d-a ḥàl-ōs abū ḥasan, qàl</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a765" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>ama bidd-i dž-àm ḥadždž ōč-am u tawab-ḥōč-am ḥaram-ta.</ANNOTATION_VALUE>
