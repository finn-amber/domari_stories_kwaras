    <TIER LINGUISTIC_TYPE_REF="imported-sep" TIER_ID="Macalister_Domari_1914">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Ắstă yikáki ṭaṭi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>ắšte wăšīs dī gṓrwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>ʕắmmă dʕrári bī́tăs ătsúntă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Štírdă min hnṓna gṓrwăk, ṭlífră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Măndṓsis ṭaṭ, răwáḥră kuriístă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Ḳāl "Săbáḥtăn lăherdṓmur, ya ŭhŭ gṓrū ḗderiămă, mărdṓmur ḗciriămă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Gṓrū mī́ndă ḥálos, rá͡ură. Láherdă ḗgăsăs illi kildḗk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Wḗsră, ḳáră minjī́s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>Ắră ăbu᷅skắră Ắbū Ḥắsăn. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>círdă ăbŭskắră, hádi gṓrū,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>wḗsrūr erhḗna?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Ihi déri nímrăs-derik; sắ'ă á͡uări, fḗri, bắgări dlaʕur"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Míndă ḥálos u gắră Ắbu Ḥắsăn nimrăskắră</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Círdă ăbúskă "Hádi gṓrwi ḳắră ḥăštširmă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Cărī́ră Ắbŭ Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Ắră ăbúskă nimr. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>"Kḗkă, gṓrū, wēsrū́ri ḗrăbiʕēma?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>"Sá͡uiōm ḥírt-keră ămata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>u mū́ṭlif hrṓmi min kúllēki, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>(u) lắherdōm ihi dériă. Durt ḳámi minjī́s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>u ha ắmă bēn xăstůrki hrṓmi."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>XXX</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Wḗsră, măndṓsis gṓru des dīs, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>Ắră ăbŭskắră Ắbū Ḥắsăn;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>ḳal gṓrū "kírwi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Ắbu Ḥắsăn ḳal, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>"Nimr măndṓsri ḗderiēmă tă-ʕádel-hōci u baʕdḗn </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts160" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>fḗri ḳăfísmă,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>mắrēk u ḳắri.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>ārṓsir nimr... lúḥră-ker íkīr ăbus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>u fúmnēs ḳurnū́rma"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>mī́ndă ḥálōs Ắbū Ḥắsăn, gắră nimrkắră, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>"Ắtū mắndōr gṓrwi răbiʕḗmă;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>ja, lắhăm gắlnă-ker wăšī́s."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>Ḳal "Kḗi íḥră?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>Ắbu Hắsăn ḳal "Drarắ-ḥră gṓrū</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>li-lăherdṓsir ḡa͡ir in mắrărir."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Mīndă ḥálos nimr, u xúlda gōrată</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts235">
                <ANNOTATION_VALUE>Gṓrū ḡắz-kerdă ḳúrnōsmă u fērṓsis ḳurnōsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts232" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>u stúhḥ-kerdă nímros. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Féros nimr gḗnă ẃinni stuḥ-kerdōsi. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>Mínde ḥalṓsăn diyḗni, mre, gṓrū u nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>Štírdă min hnṓnă Ắbū Ḥắsăn, gắră ḳắra diyēnímmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Nádi-kerdă bá͡iis u potrés</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>ḳắre wăšī́s. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Lắmmă nī mắndă diyēnánki ḡa͡ir xáre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>abu ḥasan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>nádi-kerdă ḳa͡umēs giš. Ḳárw xárăn, mī́nde ḥalḗsăn u gắre. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Ná͡ură Ắbū Ḥắsăn, lắherdă fŭrwēk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53"
                TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>(u) tirdṓsis pălḗsta. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54"
                TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>níngră ḗmŭḡărēma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>lắherdă bárūs nimráski mŭḡărḗma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>Mīndṓsis nimr, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE> "Abu Ḥắsăn, kḗkă mắrdōr bárōm?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>"ắmă nī ḥrṓmi gṓrwi"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>"Atū illi iktōr făsádi"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE>Lắherdă nimr fū́rwē pălḗstik;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>kal; "Abū Ḥắsăn, kérēk ămákă yikák miθl á͡urăki?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>Rū́dră Ắbū Ḥắsăn "Kérămiː</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63"
                TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>năn ămákă štar bắkră gắrdă,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64"
                TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>mắrēsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>tă-kérăm ăbŭrkắră fū́rwek."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66"
                TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>mī́ndă ḥálōs nimr, nắndă ăbŭskắra štar bắkră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67"
                TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>Ḳắră másiăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68"
                TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>úktă ḳálăn cálăsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts388" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>Ắră nimr ăbŭskắră, kal "Ka fū́rwē, Ắbū Ḥắsăn?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Ḳal "Mángări bắkrăk gḗnă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>Nắndă ăbŭskắră nimr bắkrăk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73"
                TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>Mărdosis, ḳārdosis Abū Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
                TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>(ḳārdosis)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75"
                TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>pánjī u potrḗs,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76"
                TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>úktă ḳálăs cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77"
                TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Ắră ăbŭskắră nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78"
                TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>"Ka fū́rwē, Ắbū Hắsăn?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79"
                TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>Ḳal "Wíndir tă-nắnămis."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80"
                TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>Nắsră Ắbū Ḥắsăn </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81"
                TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>rắsrōs nimr</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82"
                TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>Mīndă ḥálōs, gắră, níngări ḗmŭḡărēmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83"
                TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>Mīndṓsis nímr dhănăbúski;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84"
                TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>intá-kerdă ḥálōs Ắbū Ḥắsăn, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85"
                TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>intá-kerdă ḥálōs Ắbū Ḥắsăn, cnī́ră dhắnăbos nimrăs-xăstásmă. Štírdă min hnṓna Ắbū Ḥắsăn, mắndă ʕắzăr. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86"
                TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Círdă nimr ăbúska, ḳal "Ắtū, Ắbu Ḥắsăn ʕắzăr-ḥrōr,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87"
                TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>jăndṓmur."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88"
                TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>Gắră min hnṓnă Ắbū Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89"
                TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>răwáḥră nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90"
                TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Gắră ékărmăskă, ḳắră ʕắnăb min mnēšī́s. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91"
                TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>(ḳắra ʕắnăb)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92"
                TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Fḗră sṓṭăk, giš jămʕătḗs ắre.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93"
                TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>"Ḳúmnăn ídrắk."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94"
                TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts538">
                <ANNOTATION_VALUE>Xla͡urdṓssăn ékărmăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95"
                TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>Ḳal "Mănimrăneʔ ḳúmnăs ḡa͡ir tăm-bắnim pin-jikḗrăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96"
                TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Băndṓssăn Ắbū Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97"
                TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>u ắră năṭrăskắră. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98"
                TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Săwúṭkērda kănísmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99"
                TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Štírdă min hnṓnă ŭhŭ năṭū́r fērṓssăn dfángmă winni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100"
                TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>giš dhănăbḗsăn kanīrḗndi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101"
                TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū Ḥắsăn, gắră nimrắskă;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102"
                TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>ḳal "Mīndṓmir, Ắbū Ḥắsăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103"
                TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>Ḳal "Ka krēk minjī́m, ya zélămi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104"
                TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>Ḳal "Ắtu pắrdōr bắkrăn u ḳārṓssăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105"
                TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>nī kérdōr fū́rwē ămăkắră."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106"
                TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>Ḳal "Ắmă nī hrṓmi."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107"
                TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Ḳal "Ắtū hrū́ri."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108"
                TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Ḳal "Kḗi jăna͡urdṓsir inni ắmă hrṓmi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109"
                TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>Ḳal "Ắmă cíndōm dhắnăbūr."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110"
                TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ḳal "Giš jămăʕtḗm ḳaribem ʕắsărne."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111"
                TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>Ḳal "Lắhămniː nádi-kerḗsăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112"
                TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Fḗre ătsántă sṓṭăk Ắbū Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113"
                TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>giš ăre ;ăherdṓssăn nimr giš ʕắzărne. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114"
                TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Nī jắndă kṓnik ílli ḳắră bắkrăn. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115"
                TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbī Ḥasăn, ʔazim kerdă nímrăs. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116"
                TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>tī́rdă ḥăssī́ri cálăs-kăpiătă Ắbu Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117"
                TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>wēšlá͡urdă nímrăs ătústă, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118"
                TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>wínni ku͡irék cálăs-mănjísmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119"
                TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Ắră min hnṓna.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120"
                TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>šibră nimr min cálăski winni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121"
                TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>mīndḗk Ăbu-Ḥắsănăs u tīrdṓsis cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122"
                TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>Ḥre diyḗni cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123"
                TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs nimr, dī dīs ibkărwa͡iánki mra. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124"
                TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>Ḳáră Ắbū Ḥắsăn nímrăs cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125"
                TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>Ắšte kăjjiḗni āréndi tă-kúnănd cmắriăn. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126"
                TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Bărdḗni slále. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127"
                TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Lắherde écălăs. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128"
                TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Ḡḗbri ătsántă găm. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129"
                TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Síte cálăstă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130"
                TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Délli-kerde cmáriăn cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131"
                TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>Sla͡urdḗndsăn cálăsmă ărătī́yōs; </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132"
                TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>Ắbu Ḥasăn nī mắndă mnḗšsăn wắlă cmắriăk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133"
                TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>săbáḥtăn inšíl-kērde kắjjie séllăs min cálăski</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134"
                TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>pánjī siték sellắsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135"
                TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>Yṓmin kíldă båră, nắsră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136"
                TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>Ắre kắjjie, rore</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137"
                TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>u gārī́re răwáḥre kuriḗsăntă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū Ḥắsăn, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139"
                TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>"Ắmă bíddi jam ḥăjjṓcăm u tăwắb-ḥṓcăm ḥărắmtă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140"
                TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>Ắstă ḳlárăki, ḳōldḗk dăwá͡iată, gărḗk ḥăjjṓcar. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141"
                TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>Mī́ndă Ắbū Ḥắsăn dhắnăbōs dăwá͡iăki. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Kăníndră ḳláră, lăherddṓsis, mīndḗk dhắnabōs dăwá͡iăki. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143"
                TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>Mīndă ḥálōs ḳláră, pḗndă ḗtirwali</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144"
                TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>u fḗră ḗfeni Ăbū-Ḥắsănăs wínni cindḗk dhắnăbos dăwá͡iăk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145"
                TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū-Ḥắsăn u gārī́ră. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146"
                TIME_SLOT_REF1="ts845" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Lắherdă ʕăsfū́ri pándăsmă sitḗk potrḗstă. </ANNOTATION_VALUE>
