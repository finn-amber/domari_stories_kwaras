    <TIER LINGUISTIC_TYPE_REF="default-lt" TIER_ID="English">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1141"
                TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>"There was a fellah"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1142"
                TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>"he had two oxen."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1143"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>"He was ploughing on them."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1144"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>"An ox arose from there, and got free."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1145"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>"The fellah left him (the ox), went to his house."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1146"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>"He said "In the morning if I see thee, oh thou ox, in this place, I will slay thee with this knife.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1147"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>"The ox betook himself and went. He saw long grass."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1148"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>"he stayed, ate of it."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1149"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>"There came to him Abu Ḥasan (the fox). Abu Ḥasan betook himself"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1151"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>"he (Abu Ḥasan) said to him (the ox):"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1152"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>"Why do you stay here?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1153"
                TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>"This is a panther's place, the hour she comes she will strike and break thy ribs""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1154"
                TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself and went to the panther."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1155"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>"He said "This ox has eaten in thy grass""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1156"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>"Abu Ḥasan was hidden"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1157"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>"the panther came to him."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1158"
                TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>"he said "Why, oh though Ox, dost thou stay in this spring-grass""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1159"
                TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>"My master ploughs on me, "</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1160"
                TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>"and I am weary from hunger"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1161"
                TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>"I saw this place and wished to eat in it."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1162"
                TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>"and I am between thy hands.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1163"
                TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>“I wanted to eat here”</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1164"
                TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>"He stayed, left the ox ten days"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1165"
                TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>"Then came to him Abu Ḥasan"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1166"
                TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>"the ox said "what is the matter?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1167"
                TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>"Abu Ḥasan said,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168"
                TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>"The panther has left thee in this place till thou become fat"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1169"
                TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>"she will strike thee with her paw"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1170"
                TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>"thou wilt die and she will eat thee."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1171"
                TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>"If the panther comes to thee, redden thy eye upon her"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1172"
                TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>"and strike her with your horn (to kill her)""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1173"
                TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself, went to the panther, said"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1174"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>""Thou hast left the ox in the spring-grass;"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1175"
                TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>"go, let me see [thee] speak with him.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1176"
                TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>"Said she "what has happened?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1177"
                TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>"Said Abu Ḥasan "The ox has become fat,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1178"
                TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts224">
                <ANNOTATION_VALUE>"so that if he sees you he will want to kill you""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1179"
                TIME_SLOT_REF1="ts225" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>"The panther went down to the ox,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1180"
                TIME_SLOT_REF1="ts231" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>"the ox thrust his horn (into the ground) and struck him"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1181"
                TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>"and split him into two pieces."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1182"
                TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts248">
                <ANNOTATION_VALUE>"The panther struck him also and split him." 'bit him'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1183"
                TIME_SLOT_REF1="ts249" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>"The two betook themselves and died, the ox and the panther."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1184"
                TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>"Abu Ḥasan arose from there, went to eat the two."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1185"
                TIME_SLOT_REF1="ts261" TIME_SLOT_REF2="ts266">
                <ANNOTATION_VALUE>"He called his wife and children,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1186"
                TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts272">
                <ANNOTATION_VALUE>"they ate with him."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1187"
                TIME_SLOT_REF1="ts273" TIME_SLOT_REF2="ts278">
                <ANNOTATION_VALUE>"[until] there remained nothing of the two but bones."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1188"
                TIME_SLOT_REF1="ts279" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>"abu ḥasan"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1189"
                TIME_SLOT_REF1="ts285" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>"called his people (to eat the bones)"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1190"
                TIME_SLOT_REF1="ts291" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>"Abu Ḥasan searched, and saw a piece of fur/sheepskin coat"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1191"
                TIME_SLOT_REF1="ts297" TIME_SLOT_REF2="ts302">
                <ANNOTATION_VALUE>"and put the coat on his shoulders."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1192"
                TIME_SLOT_REF1="ts303" TIME_SLOT_REF2="ts308">
                <ANNOTATION_VALUE>"He entered a cave,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1193"
                TIME_SLOT_REF1="ts309" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>"saw the brother of the panther in the cave."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1194"
                TIME_SLOT_REF1="ts315" TIME_SLOT_REF2="ts320">
                <ANNOTATION_VALUE>"The panther took him and saidː"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1195"
                TIME_SLOT_REF1="ts321" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>""Abu Ḥasan, why hast thou slain my brother?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1196"
                TIME_SLOT_REF1="ts327" TIME_SLOT_REF2="ts332">
                <ANNOTATION_VALUE>""I am not the ox" (said by Abu Ḥasan)"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1197"
                TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>""It is he who roused the quarrel" (said by Abu Ḥasan)"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1198"
                TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>"The panther saw the sheepskin coat which was on his shoulder."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1199"
                TIME_SLOT_REF1="ts345" TIME_SLOT_REF2="ts350">
                <ANNOTATION_VALUE>"Abu Ḥasan, Wilt though make for me one like that?"" 'like this one'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1200"
                TIME_SLOT_REF1="ts351" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>"Abu Ḥasan answered him "I will make it"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1201"
                TIME_SLOT_REF1="ts357" TIME_SLOT_REF2="ts362">
                <ANNOTATION_VALUE>"fetch me four good sheep,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1202"
                TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts368">
                <ANNOTATION_VALUE>"kill them"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1203"
                TIME_SLOT_REF1="ts369" TIME_SLOT_REF2="ts374">
                <ANNOTATION_VALUE>"(so) that I may make for thee a sheepskin coat.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1204"
                TIME_SLOT_REF1="ts375" TIME_SLOT_REF2="ts380">
                <ANNOTATION_VALUE>"The panther betook himself, brought four sheep to him."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1205"
                TIME_SLOT_REF1="ts381" TIME_SLOT_REF2="ts386">
                <ANNOTATION_VALUE>"He ate the flesh"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1206"
                TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts393">
                <ANNOTATION_VALUE>"and cast the skins in a pit"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1208"
                TIME_SLOT_REF1="ts390" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>"The panther came to him and said "Where is the coat, Abu Ḥasan?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1209"
                TIME_SLOT_REF1="ts399" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>"He said " there lacks another sheep""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1210"
                TIME_SLOT_REF1="ts405" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>"The panther brought him a sheep"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1211"
                TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>"Abu Ḥasan killed it,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1212"
                TIME_SLOT_REF1="ts417" TIME_SLOT_REF2="ts422">
                <ANNOTATION_VALUE>"ate it"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1213"
                TIME_SLOT_REF1="ts423" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>"he and his children."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1214"
                TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts434">
                <ANNOTATION_VALUE>"and cast the skin into a pit."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1215"
                TIME_SLOT_REF1="ts435" TIME_SLOT_REF2="ts440">
                <ANNOTATION_VALUE>"The panther came to him"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1216"
                TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts446">
                <ANNOTATION_VALUE>"he said, "where is the coat, Abu Ḥasan?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1217"
                TIME_SLOT_REF1="ts447" TIME_SLOT_REF2="ts452">
                <ANNOTATION_VALUE>"He said "stay till I bring it""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1218"
                TIME_SLOT_REF1="ts453" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>"Abu Ḥasan fled" 'chased him'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1219"
                TIME_SLOT_REF1="ts459" TIME_SLOT_REF2="ts464">
                <ANNOTATION_VALUE>"the panther followed him"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1220"
                TIME_SLOT_REF1="ts465" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>"He betook himself and went, he enters a cave"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1221"
                TIME_SLOT_REF1="ts471" TIME_SLOT_REF2="ts476">
                <ANNOTATION_VALUE>"He took him by his tail;"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1222"
                TIME_SLOT_REF1="ts477" TIME_SLOT_REF2="ts482">
                <ANNOTATION_VALUE>"Abu Ḥasan pulled himself (and escaped),"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1223"
                TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts488">
                <ANNOTATION_VALUE>"his tail was cut in the paw of the panther. Abu Ḥasan rose from there and remained tailless."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1224"
                TIME_SLOT_REF1="ts489" TIME_SLOT_REF2="ts494">
                <ANNOTATION_VALUE>"The panther said to him, "Thou art tailless, Abu Ḥasan,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1225"
                TIME_SLOT_REF1="ts495" TIME_SLOT_REF2="ts500">
                <ANNOTATION_VALUE>"I will know thee.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1226"
                TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts506">
                <ANNOTATION_VALUE>"Abu Ḥasan went from there,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1227"
                TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts512">
                <ANNOTATION_VALUE>"the panther departed."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1228"
                TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts518">
                <ANNOTATION_VALUE>"He went to a vineyard, (ate grapes) from it."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1229"
                TIME_SLOT_REF1="ts519" TIME_SLOT_REF2="ts524">
                <ANNOTATION_VALUE>"ate grapes"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1230"
                TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts530">
                <ANNOTATION_VALUE>"He gave a shout (and) all of his people came."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1231"
                TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts536">
                <ANNOTATION_VALUE>"(he said) "Let us eat grapes""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1232"
                TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>"he made them descend into the vineyard."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1233"
                TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts548">
                <ANNOTATION_VALUE>"he said "I will not suffer you to eat unless I bind your tails""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1234"
                TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts554">
                <ANNOTATION_VALUE>"Abu Ḥasan bound them"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1235"
                TIME_SLOT_REF1="ts555" TIME_SLOT_REF2="ts560">
                <ANNOTATION_VALUE>"and came the watchman."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1236"
                TIME_SLOT_REF1="ts561" TIME_SLOT_REF2="ts566">
                <ANNOTATION_VALUE>"He shouted in his ear"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1237"
                TIME_SLOT_REF1="ts567" TIME_SLOT_REF2="ts572">
                <ANNOTATION_VALUE>"The watchman rose from there, shot them with a gun"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1238"
                TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts578">
                <ANNOTATION_VALUE>"and all their tails were plucked out."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1239"
                TIME_SLOT_REF1="ts579" TIME_SLOT_REF2="ts584">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself and went to the panther."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1240"
                TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts590">
                <ANNOTATION_VALUE>"He said "I will seize thee, Abu Ḥasan.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1241"
                TIME_SLOT_REF1="ts591" TIME_SLOT_REF2="ts596">
                <ANNOTATION_VALUE>"He said "Fellow, what dost thou with me?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1242"
                TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts602">
                <ANNOTATION_VALUE>"He said "thou has taken the sheep and eaten them"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1243"
                TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts608">
                <ANNOTATION_VALUE>"and dist not make the sheepskin coat for me""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1244"
                TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts614">
                <ANNOTATION_VALUE>"he said "It is not I""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1245"
                TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts620">
                <ANNOTATION_VALUE>"He said "It is thee""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1246"
                TIME_SLOT_REF1="ts621" TIME_SLOT_REF2="ts626">
                <ANNOTATION_VALUE>"He said "Who told thee that it was I?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1247"
                TIME_SLOT_REF1="ts627" TIME_SLOT_REF2="ts632">
                <ANNOTATION_VALUE>"he said "I cut off thy tail""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1248"
                TIME_SLOT_REF1="ts633" TIME_SLOT_REF2="ts638">
                <ANNOTATION_VALUE>"He said "All my people, all my near relations, are tailless""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1249"
                TIME_SLOT_REF1="ts639" TIME_SLOT_REF2="ts644">
                <ANNOTATION_VALUE>"He said "Let me see, call them""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1250"
                TIME_SLOT_REF1="ts645" TIME_SLOT_REF2="ts650">
                <ANNOTATION_VALUE>"Abu Ḥasan shouted to them,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1251"
                TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts656">
                <ANNOTATION_VALUE>"and they all came, the panther saw that they were all tailless."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1252"
                TIME_SLOT_REF1="ts657" TIME_SLOT_REF2="ts662">
                <ANNOTATION_VALUE>"he did not know which was the one who had eaten the sheep"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1253"
                TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts668">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself and invited the panther"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1254"
                TIME_SLOT_REF1="ts669" TIME_SLOT_REF2="ts674">
                <ANNOTATION_VALUE>"Abu Ḥasan put a carpet on the mouth of the well"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1255"
                TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts680">
                <ANNOTATION_VALUE>"and caused the panther to sit on it"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1256"
                TIME_SLOT_REF1="ts681" TIME_SLOT_REF2="ts686">
                <ANNOTATION_VALUE>"and he fell into the middle of the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1257"
                TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts692">
                <ANNOTATION_VALUE>"The panther came from there"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1258"
                TIME_SLOT_REF1="ts693" TIME_SLOT_REF2="ts698">
                <ANNOTATION_VALUE>"leapt from the well,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1259"
                TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>"seized Abu Ḥasan and put him in the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1260"
                TIME_SLOT_REF1="ts705" TIME_SLOT_REF2="ts710">
                <ANNOTATION_VALUE>"The two were in the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1261"
                TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts716">
                <ANNOTATION_VALUE>"In two days the panther died of hunger"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1262"
                TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts722">
                <ANNOTATION_VALUE>"Abu Ḥasan ate the panther in the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1263"
                TIME_SLOT_REF1="ts723" TIME_SLOT_REF2="ts728">
                <ANNOTATION_VALUE>"There were women going to sell chickens."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1264"
                TIME_SLOT_REF1="ts729" TIME_SLOT_REF2="ts734">
                <ANNOTATION_VALUE>"Their baskets were full"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1265"
                TIME_SLOT_REF1="ts735" TIME_SLOT_REF2="ts740">
                <ANNOTATION_VALUE>"They saw that well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1266"
                TIME_SLOT_REF1="ts741" TIME_SLOT_REF2="ts746">
                <ANNOTATION_VALUE>"The sun set on them."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1267"
                TIME_SLOT_REF1="ts747" TIME_SLOT_REF2="ts752">
                <ANNOTATION_VALUE>"They slept by the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1268"
                TIME_SLOT_REF1="ts753" TIME_SLOT_REF2="ts758">
                <ANNOTATION_VALUE>"They lowered the chickens into the well."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1269"
                TIME_SLOT_REF1="ts759" TIME_SLOT_REF2="ts764">
                <ANNOTATION_VALUE>"They made them sleep in the well that night"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1270"
                TIME_SLOT_REF1="ts765" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>"Abu Ḥasan did not leave a single chicken of them."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1271"
                TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>"In the morning the women raised the basket from the well. they took out the basket"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1272"
                TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>"he/Abu Ḥasan was sleeping in the basketǃ"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1273"
                TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>"When he got up outside, he fled"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1274"
                TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>"Those women wept"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1275"
                TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>"and returned, departed to their houses."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1276"
                TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself, he said"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1277"
                TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>""I want to go to the haj and cease from sin""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1278"
                TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>"There was a bedawi riding a camel, going to the haj."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1279"
                TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>"Abu Ḥasan seized the tail of the camel."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1280"
                TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>"The bedawi looked and saw him seizing the tail of the camel."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1281"
                TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>"The bedawi betook himself, seized the sword,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1282"
                TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>"And struck Abu Ḥasan thus, and cut the tail of his camel."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1283"
                TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>"Abu Ḥasan betook himself and returned."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1284"
                TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>"He saw a bird on the way sleeping on its young."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1285"
                TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>"he came from there to eat its children"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1286"
                TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts866">
                <ANNOTATION_VALUE>"Don't eat my childrenǃ"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1287"
                TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>"Abu Ḥasan said "Make me laugh"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1288"
                TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>"She said "At what?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1289"
                TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>"He said "At those harvesters.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1290"
                TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>"She said "stay where you are""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1291"
                TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>"The bird came, sat on the head of one of the men."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1292"
                TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>"One man came from there, he came to strike the bird with the sickle;"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1293"
                TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>"he cut off the head of the man."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1294"
                TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>"Abu Ḥasan laughed, he was contented."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1295"
                TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts920">
                <ANNOTATION_VALUE>"He rushed on the children of the bird, he went to eat them."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1296"
                TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts926">
                <ANNOTATION_VALUE>"She said "What do you want?""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1297"
                TIME_SLOT_REF1="ts927" TIME_SLOT_REF2="ts932">
                <ANNOTATION_VALUE>"he said "I am thirsty, I want to drink"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1298"
                TIME_SLOT_REF1="ts933" TIME_SLOT_REF2="ts938">
                <ANNOTATION_VALUE>"that which a woman is carrying in a jug of water.""</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1299"
                TIME_SLOT_REF1="ts939" TIME_SLOT_REF2="ts944">
                <ANNOTATION_VALUE>"The bird stepped in front of the woman."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1300"
                TIME_SLOT_REF1="ts945" TIME_SLOT_REF2="ts950">
                <ANNOTATION_VALUE>"The woman set down her jugs there,"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1301"
                TIME_SLOT_REF1="ts951" TIME_SLOT_REF2="ts956">
                <ANNOTATION_VALUE>"and ran to take the bird."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1302"
                TIME_SLOT_REF1="ts957" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>"Abu Ḥasan came, drank all her water."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false"
        LINGUISTIC_TYPE_ID="default-lt" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false"
        LINGUISTIC_TYPE_ID="imported-sep" TIME_ALIGNABLE="true"/>
    <LINGUISTIC_TYPE CONSTRAINTS="Symbolic_Association"
        GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="SymbAssoc" TIME_ALIGNABLE="false"/>
    <CONSTRAINT
        DESCRIPTION="Time subdivision of parent annotation's time interval, no time gaps allowed within this interval" STEREOTYPE="Time_Subdivision"/>
    <CONSTRAINT
        DESCRIPTION="Symbolic subdivision of a parent annotation. Annotations refering to the same parent are ordered" STEREOTYPE="Symbolic_Subdivision"/>
    <CONSTRAINT DESCRIPTION="1-1 association with a parent annotation" STEREOTYPE="Symbolic_Association"/>
    <CONSTRAINT
        DESCRIPTION="Time alignable annotations within the parent annotation's time interval, gaps are allowed" STEREOTYPE="Included_In"/>
</ANNOTATION_DOCUMENT>
