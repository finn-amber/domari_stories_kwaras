        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1085" ANNOTATION_REF="a465">
                <ANNOTATION_VALUE>ū gar-ī-r-e kury-a-san-ka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1087" ANNOTATION_REF="a466">
                <ANNOTATION_VALUE>abu ḥasan š-ird-a:</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1089" ANNOTATION_REF="a467">
                <ANNOTATION_VALUE>ama bidd-ī h-ōš-am hāž ū baṭṭil-h-ōš-am qumn-am ū qaft-am.</ANNOTATION_VALUE>
