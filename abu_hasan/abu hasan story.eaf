        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1079" ANNOTATION_REF="a462">
                <ANNOTATION_VALUE>abu ḥasan sit-a mandž-is-ma sall-ē-i.</ANNOTATION_VALUE>
