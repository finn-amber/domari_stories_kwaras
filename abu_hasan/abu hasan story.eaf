        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1017" ANNOTATION_REF="a431">
                <ANNOTATION_VALUE>kēkē kar wās-ir?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1019" ANNOTATION_REF="a432">
                <ANNOTATION_VALUE>atu qē-r-or xurfān-an qē-r-or-san,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1021" ANNOTATION_REF="a433">
                <ANNOTATION_VALUE>na ka-d-or ama-ke balṭa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1023" ANNOTATION_REF="a434">
                <ANNOTATION_VALUE>š-ird-a ab-us-ke mišš ama-k</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1025" ANNOTATION_REF="a435">
                <ANNOTATION_VALUE>š-ird-a ab-us-ke: atu h-r-or-i.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1027" ANNOTATION_REF="a436">
                <ANNOTATION_VALUE>š-ird-a ab-us-ke kān-i š-ird-a ab-ur-ke inn-i ama-k?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1029" ANNOTATION_REF="a437">
                <ANNOTATION_VALUE>ama š-ind-om ab-ur-ke danab-ir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1031" ANNOTATION_REF="a438">
                <ANNOTATION_VALUE>giš qarāib-ē-m nhe’ ab-san-ke danab-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1033" ANNOTATION_REF="a439">
                <ANNOTATION_VALUE>dža nadi-k-ē-san!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1035" ANNOTATION_REF="a440">
                <ANNOTATION_VALUE>abu ḥasan nadi-k-ed-os-san</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1037" ANNOTATION_REF="a441">
                <ANNOTATION_VALUE>ū gištane-san nhe’ ab-san-ke danab-e.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1039" ANNOTATION_REF="a442">
                <ANNOTATION_VALUE>nimer-ma dž-and-a kān-ik mindžī-san illi qēy-r-a xurfān-an.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1041" ANNOTATION_REF="a443">
