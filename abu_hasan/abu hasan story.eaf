        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1043" ANNOTATION_REF="a444">
                <ANNOTATION_VALUE>abu ḥasan t-ird-a bsāṭ-ēk šāł-as-ka.</ANNOTATION_VALUE>
