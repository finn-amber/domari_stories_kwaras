        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1137" ANNOTATION_REF="a491">
                <ANNOTATION_VALUE>ū ga-r-i biddh-a mīn-ar ʕaṣfur-ī,</ANNOTATION_VALUE>
