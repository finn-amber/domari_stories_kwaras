        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1073" ANNOTATION_REF="a459">
                <ANNOTATION_VALUE>ʕašan šū-š-ad šāł-as-ma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1075" ANNOTATION_REF="a460">
                <ANNOTATION_VALUE>abu ḥasan qē-r-a giš šmary-an</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1077" ANNOTATION_REF="a461">
                <ANNOTATION_VALUE>sabaḥtan džuwr-e kšal-d-e sall-ēy, nhe’, fāḍi-ni.</ANNOTATION_VALUE>
