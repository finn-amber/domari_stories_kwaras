        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1053" ANNOTATION_REF="a449">
                <ANNOTATION_VALUE>mīn-d-a abu ḥasan-as kur-d-os-is šāł-ās-ma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1055" ANNOTATION_REF="a450">
                <ANNOTATION_VALUE>din-ē-san kānu šāł-as-m-ēni.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1057" ANNOTATION_REF="a451">
                <ANNOTATION_VALUE>baʕd di dīs nimer bkara-h-r-a,</ANNOTATION_VALUE>
