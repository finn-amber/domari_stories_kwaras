        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1095" ANNOTATION_REF="a470">
                <ANNOTATION_VALUE>qrara kahind-ar-a lah-ed-os-is mīn-d-ēk danab-is dawāy-ki</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1097" ANNOTATION_REF="a471">
