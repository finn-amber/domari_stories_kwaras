            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1051" ANNOTATION_REF="a448">
                <ANNOTATION_VALUE>ū nuṭṭ-ah-r-a ū kil-d-a bara,</ANNOTATION_VALUE>
