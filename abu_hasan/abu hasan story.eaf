        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1081" ANNOTATION_REF="a463">
                <ANNOTATION_VALUE>lamma isḥa-h-r-a nas-r-a,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1083" ANNOTATION_REF="a464">
                <ANNOTATION_VALUE>džuwr-e row-r-e,</ANNOTATION_VALUE>
