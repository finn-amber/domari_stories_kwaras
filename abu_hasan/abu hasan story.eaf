        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1091" ANNOTATION_REF="a468">
                <ANNOTATION_VALUE>lak-ed-a qrara ū qul-d-ēk dawāy-ka bidd-ō dža hižž-hō-š-ār.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1093" ANNOTATION_REF="a469">
                <ANNOTATION_VALUE>mīn-d-a danab-is dawāy-ki,</ANNOTATION_VALUE>
