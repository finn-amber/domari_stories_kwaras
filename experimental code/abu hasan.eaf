    <TIER LINGUISTIC_TYPE_REF="imported-sep" TIER_ID="Macalister_Domari_1914">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Ắstă yikáki ṭaṭi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>ắšte wăšts dī gṓrwi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>ʕắmmă dʕrári bī́tăs ătsúntă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>Štírdă min hnṓna gṓrwăk, ṭlífră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Măndṓsis ṭaṭ, răwáḥră kuriístă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Ḳāl "Săbáḥtăn lăherdṓmur, ya ŭhŭ gṓrū ḗderiămă, mărdṓmur ḗciriămă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Gṓrū mī́ndă ḥálos, rá͡ură. Láherdă ḗgăsăs illi kildḗk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Wḗsră, ḳáră minjī́s.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Ắră ăbu᷅skắră Ắbū Ḥắsăn.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Mī́ndă ḥálos Ắbū Ḥắsăn, círdă ăbŭskắră</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>círdă ăbŭskắră</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>"Hádi gṓrū, wḗsrūr erhḗna?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Ihi déri nímrăs-derik; sắ'ă á͡uări, fḗri, bắgări dlaʕur"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Míndă ḥálos u gắră Ắbu Ḥắsăn nimrăskắră</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Círdă ăbúskă "Hádi gṓrwi ḳắră ḥăštširmă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Cărī́ră Ắbŭ Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts95" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>Ắră ăbúskă nimr. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>"Kḗkă, gṓrū, wēsrū́ri ḗrăbiʕēma?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>"Sá͡uiōm ḥírt-keră ămata</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>u mū́ṭlif hrṓmi min kúllēki, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>(u) lắherdōm ihi dériă. Durt ḳámi minjī́s</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts125" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>u ha ắmă bēn xăstůrki hrṓmi."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts136">
                <ANNOTATION_VALUE>Wḗsră, măndṓsis gṓru des dīs, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24"
                TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts142">
                <ANNOTATION_VALUE>tillá-ḥră ḳadd dăwá͡iiki. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts148">
                <ANNOTATION_VALUE>Ắră ăbŭskắră Ắbū Ḥắsăn;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts149" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>ḳal gṓrū "kírwi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts160">
                <ANNOTATION_VALUE>Ắbu Ḥắsăn ḳal, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28"
                TIME_SLOT_REF1="ts161" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>"Nimr măndṓsri ḗderiēmă tă-ʕádel-hōci</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29"
                TIME_SLOT_REF1="ts167" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>u baʕdḗn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30"
                TIME_SLOT_REF1="ts173" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>fḗri ḳăfísmă,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a31"
                TIME_SLOT_REF1="ts179" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>mắrēk u ḳắri.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a32"
                TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts190">
                <ANNOTATION_VALUE>ārṓsir nimr... lúḥră-ker íkīr ăbus.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33"
                TIME_SLOT_REF1="ts191" TIME_SLOT_REF2="ts196">
                <ANNOTATION_VALUE>u fúmnēs ḳurnū́rma"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a34"
                TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts202">
                <ANNOTATION_VALUE>mī́ndă ḥálōs Ắbū Ḥắsăn, gắră nimrkắră, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a35"
                TIME_SLOT_REF1="ts203" TIME_SLOT_REF2="ts208">
                <ANNOTATION_VALUE>"Ắtū mắndōr gṓrwi răbiʕḗmă;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a36"
                TIME_SLOT_REF1="ts209" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>ja, lắhăm gắlnă-ker wăšī́s."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a37"
                TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Ḳal "Kḗi íḥră?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a38"
                TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Ắbu Hắsăn ḳal "Drarắ-ḥră gṓrū</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a39"
                TIME_SLOT_REF1="ts227" TIME_SLOT_REF2="ts232">
                <ANNOTATION_VALUE>li-lăherdṓsir ḡa͡ir in mắrărir."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a40"
                TIME_SLOT_REF1="ts233" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>Mīndă ḥálos nimr, u xúlda gōrată</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a41"
                TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts244">
                <ANNOTATION_VALUE>Gṓrū ḡắz-kerdă ḳúrnōsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a42"
                TIME_SLOT_REF1="ts245" TIME_SLOT_REF2="ts250">
                <ANNOTATION_VALUE>u fērṓsis ḳurnōsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a43"
                TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts256">
                <ANNOTATION_VALUE>u stúhḥ-kerdă nímros. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a44"
                TIME_SLOT_REF1="ts257" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Féros nimr gḗnă ẃinni stuḥ-kerdōsi. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a45"
                TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Mínde ḥalṓsăn diyḗni, mre, gṓrū u nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a46"
                TIME_SLOT_REF1="ts269" TIME_SLOT_REF2="ts274">
                <ANNOTATION_VALUE>Štírdă min hnṓnă Ắbū Ḥắsăn, gắră ḳắra diyēnímmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a47"
                TIME_SLOT_REF1="ts275" TIME_SLOT_REF2="ts280">
                <ANNOTATION_VALUE>Nádi-kerdă bá͡iis u potrés</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a48"
                TIME_SLOT_REF1="ts281" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>ḳắre wăšī́s. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a49"
                TIME_SLOT_REF1="ts287" TIME_SLOT_REF2="ts292">
                <ANNOTATION_VALUE>Lắmmă nī mắndă diyēnánki ḡa͡ir xáre,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a50"
                TIME_SLOT_REF1="ts293" TIME_SLOT_REF2="ts298">
                <ANNOTATION_VALUE>abu ḥasan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a51"
                TIME_SLOT_REF1="ts299" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>nádi-kerdă ḳa͡umēs giš. Ḳárw xárăn, mī́nde ḥalḗsăn u gắre. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a52"
                TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts310">
                <ANNOTATION_VALUE>Ná͡ură Ắbū Ḥắsăn, lắherdă fŭrwēk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a53"
                TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts316">
                <ANNOTATION_VALUE>(u) tirdṓsis pălḗsta. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a54"
                TIME_SLOT_REF1="ts317" TIME_SLOT_REF2="ts322">
                <ANNOTATION_VALUE>níngră ḗmŭḡărēma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts323" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>lắherdă bárūs nimráski mŭḡărḗma.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts334">
                <ANNOTATION_VALUE>Mīndṓsis nimr, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts335" TIME_SLOT_REF2="ts340">
                <ANNOTATION_VALUE> "Abu Ḥắsăn, kḗkă mắrdōr bárōm?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a58"
                TIME_SLOT_REF1="ts341" TIME_SLOT_REF2="ts346">
                <ANNOTATION_VALUE>"ắmă nī ḥrṓmi gṓrwi"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts347" TIME_SLOT_REF2="ts352">
                <ANNOTATION_VALUE>"Atū illi iktōr făsádi"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Lắherdă nimr fū́rwē pălḗstik;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a61"
                TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>kal; "Abū Ḥắsăn, kérēk ămákă yikák miθl á͡urăki?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a62"
                TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Rū́dră Ắbū Ḥắsăn "Kérămiː</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a63"
                TIME_SLOT_REF1="ts371" TIME_SLOT_REF2="ts376">
                <ANNOTATION_VALUE>năn ămákă štar bắkră gắrdă,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a64"
                TIME_SLOT_REF1="ts377" TIME_SLOT_REF2="ts382">
                <ANNOTATION_VALUE>mắrēsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts383" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>tă-kérăm ăbŭrkắră fū́rwek."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a66"
                TIME_SLOT_REF1="ts389" TIME_SLOT_REF2="ts394">
                <ANNOTATION_VALUE>mī́ndă ḥálōs nimr, nắndă ăbŭskắra štar bắkră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a67"
                TIME_SLOT_REF1="ts395" TIME_SLOT_REF2="ts400">
                <ANNOTATION_VALUE>Ḳắră másiăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a68"
                TIME_SLOT_REF1="ts401" TIME_SLOT_REF2="ts406">
                <ANNOTATION_VALUE>úktă ḳálăn cálăsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a69"
                TIME_SLOT_REF1="ts407" TIME_SLOT_REF2="ts412">
                <ANNOTATION_VALUE>cálăsmă</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts413" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Ắră nimr ăbŭskắră, kal "Ka fū́rwē, Ắbū Ḥắsăn?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts424">
                <ANNOTATION_VALUE>Ḳal "Mángări bắkrăk gḗnă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts425" TIME_SLOT_REF2="ts430">
                <ANNOTATION_VALUE>Nắndă ăbŭskắră nimr bắkrăk.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73"
                TIME_SLOT_REF1="ts431" TIME_SLOT_REF2="ts436">
                <ANNOTATION_VALUE>Mărdosis, ḳārdosis Abū Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
                TIME_SLOT_REF1="ts437" TIME_SLOT_REF2="ts442">
                <ANNOTATION_VALUE>(ḳārdosis)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a75"
                TIME_SLOT_REF1="ts443" TIME_SLOT_REF2="ts448">
                <ANNOTATION_VALUE>pánjī u potrḗs,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a76"
                TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts454">
                <ANNOTATION_VALUE>úktă ḳálăs cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a77"
                TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts460">
                <ANNOTATION_VALUE>Ắră ăbŭskắră nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a78"
                TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts466">
                <ANNOTATION_VALUE>"Ka fū́rwē, Ắbū Hắsăn?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a79"
                TIME_SLOT_REF1="ts467" TIME_SLOT_REF2="ts472">
                <ANNOTATION_VALUE>Ḳal "Wíndir tă-nắnămis."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a80"
                TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts478">
                <ANNOTATION_VALUE>Nắsră Ắbū Ḥắsăn </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a81"
                TIME_SLOT_REF1="ts479" TIME_SLOT_REF2="ts484">
                <ANNOTATION_VALUE>rắsrōs nimr</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a82"
                TIME_SLOT_REF1="ts485" TIME_SLOT_REF2="ts490">
                <ANNOTATION_VALUE>Mīndă ḥálōs, gắră, níngări ḗmŭḡărēmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a83"
                TIME_SLOT_REF1="ts491" TIME_SLOT_REF2="ts496">
                <ANNOTATION_VALUE>Mīndṓsis nímr dhănăbúski;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a84"
                TIME_SLOT_REF1="ts497" TIME_SLOT_REF2="ts502">
                <ANNOTATION_VALUE>intá-kerdă ḥálōs Ắbū Ḥắsăn, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a85"
                TIME_SLOT_REF1="ts503" TIME_SLOT_REF2="ts508">
                <ANNOTATION_VALUE>intá-kerdă ḥálōs Ắbū Ḥắsăn, cnī́ră dhắnăbos nimrăs-xăstásmă. Štírdă min hnṓna Ắbū Ḥắsăn, mắndă ʕắzăr. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a86"
                TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts514">
                <ANNOTATION_VALUE>Círdă nimr ăbúska, ḳal "Ắtū, Ắbu Ḥắsăn ʕắzăr-ḥrōr,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a87"
                TIME_SLOT_REF1="ts515" TIME_SLOT_REF2="ts520">
                <ANNOTATION_VALUE>jăndṓmur."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a88"
                TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts526">
                <ANNOTATION_VALUE>Gắră min hnṓnă Ắbū Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a89"
                TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts532">
                <ANNOTATION_VALUE>răwáḥră nimr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a90"
                TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts538">
                <ANNOTATION_VALUE>Gắră ékărmăskă, ḳắră ʕắnăb min mnēšī́s. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a91"
                TIME_SLOT_REF1="ts539" TIME_SLOT_REF2="ts544">
                <ANNOTATION_VALUE>(ḳắra ʕắnăb)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a92"
                TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts550">
                <ANNOTATION_VALUE>Fḗră sṓṭăk, giš jămʕătḗs ắre.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a93"
                TIME_SLOT_REF1="ts551" TIME_SLOT_REF2="ts556">
                <ANNOTATION_VALUE>"Ḳúmnăn ídrắk."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a94"
                TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts562">
                <ANNOTATION_VALUE>Xla͡urdṓssăn ékărmăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a95"
                TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts568">
                <ANNOTATION_VALUE>Ḳal "Mănimrăneʔ ḳúmnăs ḡa͡ir tăm-bắnim pin-jikḗrăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a96"
                TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts574">
                <ANNOTATION_VALUE>Băndṓssăn Ắbū Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a97"
                TIME_SLOT_REF1="ts575" TIME_SLOT_REF2="ts580">
                <ANNOTATION_VALUE>u ắră năṭrăskắră. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a98"
                TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>Săwúṭkērda kănísmă.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a99"
                TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts592">
                <ANNOTATION_VALUE>Štírdă min hnṓnă ŭhŭ năṭū́r fērṓssăn dfángmă winni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a100"
                TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts598">
                <ANNOTATION_VALUE>giš dhănăbḗsăn kanīrḗndi</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a101"
                TIME_SLOT_REF1="ts599" TIME_SLOT_REF2="ts604">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū Ḥắsăn, gắră nimrắskă;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102"
                TIME_SLOT_REF1="ts605" TIME_SLOT_REF2="ts610">
                <ANNOTATION_VALUE>ḳal "Mīndṓmir, Ắbū Ḥắsăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103"
                TIME_SLOT_REF1="ts611" TIME_SLOT_REF2="ts616">
                <ANNOTATION_VALUE>Ḳal "Ka krēk minjī́m, ya zélămi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104"
                TIME_SLOT_REF1="ts617" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Ḳal "Ắtu pắrdōr bắkrăn u ḳārṓssăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105"
                TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts628">
                <ANNOTATION_VALUE>nī kérdōr fū́rwē ămăkắră."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a106"
                TIME_SLOT_REF1="ts629" TIME_SLOT_REF2="ts634">
                <ANNOTATION_VALUE>Ḳal "Ắmă nī hrṓmi."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a107"
                TIME_SLOT_REF1="ts635" TIME_SLOT_REF2="ts640">
                <ANNOTATION_VALUE>Ḳal "Ắtū hrū́ri."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a108"
                TIME_SLOT_REF1="ts641" TIME_SLOT_REF2="ts646">
                <ANNOTATION_VALUE>Ḳal "Kḗi jăna͡urdṓsir inni ắmă hrṓmi?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a109"
                TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts652">
                <ANNOTATION_VALUE>Ḳal "Ắmă cíndōm dhắnăbūr."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a110"
                TIME_SLOT_REF1="ts653" TIME_SLOT_REF2="ts658">
                <ANNOTATION_VALUE>Ḳal "Giš jămăʕtḗm ḳaribem ʕắsărne."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a111"
                TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts664">
                <ANNOTATION_VALUE>Ḳal "Lắhămniː nádi-kerḗsăn."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a112"
                TIME_SLOT_REF1="ts665" TIME_SLOT_REF2="ts670">
                <ANNOTATION_VALUE>Fḗre ătsántă sṓṭăk Ắbū Ḥắsăn,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a113"
                TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts676">
                <ANNOTATION_VALUE>giš ăre ;ăherdṓssăn nimr giš ʕắzărne. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a114"
                TIME_SLOT_REF1="ts677" TIME_SLOT_REF2="ts682">
                <ANNOTATION_VALUE>Nī jắndă kṓnik ílli ḳắră bắkrăn. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a115"
                TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts688">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbī Ḥasăn, ʔazim kerdă nímrăs. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a116"
                TIME_SLOT_REF1="ts689" TIME_SLOT_REF2="ts694">
                <ANNOTATION_VALUE>tī́rdă ḥăssī́ri cálăs-kăpiătă Ắbu Ḥắsăn</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a117"
                TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts700">
                <ANNOTATION_VALUE>wēšlá͡urdă nímrăs ătústă, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a118"
                TIME_SLOT_REF1="ts701" TIME_SLOT_REF2="ts706">
                <ANNOTATION_VALUE>wínni ku͡irék cálăs-mănjísmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a119"
                TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts712">
                <ANNOTATION_VALUE>Ắră min hnṓna.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a120"
                TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts718">
                <ANNOTATION_VALUE>šibră nimr min cálăski winni</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a121"
                TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts724">
                <ANNOTATION_VALUE>mīndḗk Ăbu-Ḥắsănăs u tīrdṓsis cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a122"
                TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts730">
                <ANNOTATION_VALUE>Ḥre diyḗni cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a123"
                TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts736">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs nimr, dī dīs ibkărwa͡iánki mra. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a124"
                TIME_SLOT_REF1="ts737" TIME_SLOT_REF2="ts742">
                <ANNOTATION_VALUE>Ḳáră Ắbū Ḥắsăn nímrăs cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a125"
                TIME_SLOT_REF1="ts743" TIME_SLOT_REF2="ts748">
                <ANNOTATION_VALUE>Ắšte kăjjiḗni āréndi tă-kúnănd cmắriăn. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a126"
                TIME_SLOT_REF1="ts749" TIME_SLOT_REF2="ts754">
                <ANNOTATION_VALUE>Bărdḗni slále. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a127"
                TIME_SLOT_REF1="ts755" TIME_SLOT_REF2="ts760">
                <ANNOTATION_VALUE>Lắherde écălăs. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a128"
                TIME_SLOT_REF1="ts761" TIME_SLOT_REF2="ts766">
                <ANNOTATION_VALUE>Ḡḗbri ătsántă găm. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a129"
                TIME_SLOT_REF1="ts767" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>Síte cálăstă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a130"
                TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>Délli-kerde cmáriăn cálăsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a131"
                TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>Sla͡urdḗndsăn cálăsmă ărătī́yōs; </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a132"
                TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>Ắbu Ḥasăn nī mắndă mnḗšsăn wắlă cmắriăk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a133"
                TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>săbáḥtăn inšíl-kērde kắjjie séllăs min cálăski</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a134"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>pánjī siték sellắsmă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a135"
                TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Yṓmin kíldă båră, nắsră.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a136"
                TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>Ắre kắjjie, rore</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a137"
                TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>u gārī́re răwáḥre kuriḗsăntă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a138"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū Ḥắsăn, ḳal</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a139"
                TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>"Ắmă bíddi jam ḥăjjṓcăm u tăwắb-ḥṓcăm ḥărắmtă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a140"
                TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>Ắstă ḳlárăki, ḳōldḗk dăwá͡iată, gărḗk ḥăjjṓcar. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a141"
                TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Mī́ndă Ắbū Ḥắsăn dhắnăbōs dăwá͡iăki. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a142"
                TIME_SLOT_REF1="ts845" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Kăníndră ḳláră, lăherddṓsis, mīndḗk dhắnabōs dăwá͡iăki. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a143"
                TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>Mīndă ḥálōs ḳláră, pḗndă ḗtirwali</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a144"
                TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>u fḗră ḗfeni Ăbū-Ḥắsănăs wínni cindḗk dhắnăbos dăwá͡iăk. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a145"
                TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts868">
                <ANNOTATION_VALUE>Mī́ndă ḥálōs Ắbū-Ḥắsăn u gārī́ră. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a146"
                TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>Lắherdă ʕăsfū́ri pándăsmă sitḗk potrḗstă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a147"
                TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>Ắră min hnṓnă tă-kúmnăr potrḗs.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a148"
                TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>ni ḳār potrḗm</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a149"
                TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>Ḳal "Xazna͡uḗm."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a150"
                TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>Ḳal "Kḗta?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a151"
                TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>Ḳal "Ehe ḥăssădīnántă."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a152"
                TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>Ḳal "Windír ŭnkī́ir."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a153"
                TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>Ắri ʕăsfū́ri, windírdi kắjjăkăs-siriătă. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a154"
                TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts922">
                <ANNOTATION_VALUE>Ắră yikák min hnṓnă, ắră tă-fúmnăr ʕasfúr menjélmă;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a155"
                TIME_SLOT_REF1="ts923" TIME_SLOT_REF2="ts928">
                <ANNOTATION_VALUE>cíndă síriōs kắjjăski. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a156"
                TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts934">
                <ANNOTATION_VALUE>Xắzră Ắbū Ḥắsăn, ibsū́ṭ-ḥră. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a157"
                TIME_SLOT_REF1="ts935" TIME_SLOT_REF2="ts940">
                <ANNOTATION_VALUE>Dá͡ură potrḗs ʕasfū́rik, gara ḳārsắnni.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a158"
                TIME_SLOT_REF1="ts941" TIME_SLOT_REF2="ts946">
                <ANNOTATION_VALUE>Ḳal "Kḗi mángēk?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a159"
                TIME_SLOT_REF1="ts947" TIME_SLOT_REF2="ts952">
                <ANNOTATION_VALUE>Ḳal "Tirăsálʕ ḥrṓmi, mángămi pī́ăm</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a160"
                TIME_SLOT_REF1="ts953" TIME_SLOT_REF2="ts958">
                <ANNOTATION_VALUE>ílli kắjjiăki štắldik kúpăki pánik."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a161"
                TIME_SLOT_REF1="ts959" TIME_SLOT_REF2="ts964">
                <ANNOTATION_VALUE>Dérijri ăgrī́s ʕăsfū́ri kájjiăki.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a162"
                TIME_SLOT_REF1="ts965" TIME_SLOT_REF2="ts970">
                <ANNOTATION_VALUE>Tī́rdik ikpḗs erhṓnă,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a163"
                TIME_SLOT_REF1="ts971" TIME_SLOT_REF2="ts976">
                <ANNOTATION_VALUE>u dá͡uri tă-mī́năr ʕăsfū́ri.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a164"
                TIME_SLOT_REF1="ts977" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>Ắră Ắbū Ḥắsăn, pīrḗk pániis giš. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="imported-sep" TIER_ID="English">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a165"
                TIME_SLOT_REF1="ts2" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>There was a fellah</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a166"
                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>he had two oxen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a167"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>He was ploughing on them. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a168"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>An ox arose from there, and got free. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a169"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>The fellah left him (the ox), went to his house.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a170"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>He said "In the morning if I see thee, oh thou ox, in this place, I will slay thee with this knife."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a171"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>The ox betook himself and went. He saw long grass. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a172"
                TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>he stayed, ate of it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a173"
                TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>There came to him Abu Ḥasan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a174"
                TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a175"
                TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>he (Abu Ḥasan) said to himː </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a176"
                TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>"Why do you stay here?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a177"
                TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>This is a panther's place, the hour she comes she will strike and break thy ribs"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a178"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself and went to the panther. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a179"
                TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>He said "This ox has eaten in thy grass"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a180"
                TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>Abu Ḥasan was hidden</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a181"
                TIME_SLOT_REF1="ts97" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>the panther came to hiim.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a182"
                TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>he said "Why, oh though Ox, dost thou stay in this spring-grass"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a183"
                TIME_SLOT_REF1="ts109" TIME_SLOT_REF2="ts114">
                <ANNOTATION_VALUE>My master ploughs on me,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a184"
                TIME_SLOT_REF1="ts115" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>and I am weary from hunger</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a185"
                TIME_SLOT_REF1="ts121" TIME_SLOT_REF2="ts126">
                <ANNOTATION_VALUE>I saw this place and wished to eat in it.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a186"
                TIME_SLOT_REF1="ts127" TIME_SLOT_REF2="ts132">
                <ANNOTATION_VALUE>and I am between thy hands."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a187"
                TIME_SLOT_REF1="ts133" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>He stayed, left the ox ten days</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a188"
                TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>it became as big as a camel</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a189"
                TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>Then came to him Abu Ḥasan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a190"
                TIME_SLOT_REF1="ts151" TIME_SLOT_REF2="ts156">
                <ANNOTATION_VALUE>the ox said "what is the matter?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a191"
                TIME_SLOT_REF1="ts157" TIME_SLOT_REF2="ts162">
                <ANNOTATION_VALUE>Abu Ḥasan said,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a192"
                TIME_SLOT_REF1="ts163" TIME_SLOT_REF2="ts168">
                <ANNOTATION_VALUE>"The panther has left thee in this place till thou become fat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a193"
                TIME_SLOT_REF1="ts169" TIME_SLOT_REF2="ts174">
                <ANNOTATION_VALUE>and aferwards</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a194"
                TIME_SLOT_REF1="ts175" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>she will strike thee with her paw</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a195"
                TIME_SLOT_REF1="ts181" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>thou wilt die and she will eat thee. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a196"
                TIME_SLOT_REF1="ts187" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>If the panther comes to thee, redden thy eye upon her</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a197"
                TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts198">
                <ANNOTATION_VALUE>and strike her with your horn (to kill her)"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a198"
                TIME_SLOT_REF1="ts199" TIME_SLOT_REF2="ts204">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself, went to the panther, said</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a199"
                TIME_SLOT_REF1="ts205" TIME_SLOT_REF2="ts210">
                <ANNOTATION_VALUE>"Thou hast left the ox in the spring-grass;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a200"
                TIME_SLOT_REF1="ts211" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>go, let me see [thee] speak with him."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201"
                TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts222">
                <ANNOTATION_VALUE>Said she "what has happened?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202"
                TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts228">
                <ANNOTATION_VALUE>Said Abu Ḥasan "The ox has become fat,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a203"
                TIME_SLOT_REF1="ts229" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>so that if he sees you he will want to kill you"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a204"
                TIME_SLOT_REF1="ts235" TIME_SLOT_REF2="ts240">
                <ANNOTATION_VALUE>The panther went down to the ox,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a205"
                TIME_SLOT_REF1="ts241" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>the ox thrust his horn (into the ground)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a206"
                TIME_SLOT_REF1="ts247" TIME_SLOT_REF2="ts252">
                <ANNOTATION_VALUE>and struck him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a207"
                TIME_SLOT_REF1="ts253" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>and split him into two pieces.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a208"
                TIME_SLOT_REF1="ts259" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>The panther struck him also and split him.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a209"
                TIME_SLOT_REF1="ts265" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>The two betook themselves and died, the ox and the panther.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a210"
                TIME_SLOT_REF1="ts271" TIME_SLOT_REF2="ts276">
                <ANNOTATION_VALUE>Abu Ḥasan arose from there, went to eat the two.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a211"
                TIME_SLOT_REF1="ts277" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>He called his wife and children,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a212"
                TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts288">
                <ANNOTATION_VALUE>they ate with him. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a213"
                TIME_SLOT_REF1="ts289" TIME_SLOT_REF2="ts294">
                <ANNOTATION_VALUE>[until] there remained nothing of the two but bones.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a214"
                TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>abu ḥasan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a215"
                TIME_SLOT_REF1="ts301" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>called his people (to eat the bones)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a216"
                TIME_SLOT_REF1="ts307" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>Abu Ḥasan searched, and saw a piece of fur/sheepskin coat</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a217"
                TIME_SLOT_REF1="ts313" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>and put the coat on his shoulders.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a218"
                TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts324">
                <ANNOTATION_VALUE>He entered a cave,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a219"
                TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts330">
                <ANNOTATION_VALUE>saw the brother of the panther in the cave.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a220"
                TIME_SLOT_REF1="ts331" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>The panther took him and saidː</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a221"
                TIME_SLOT_REF1="ts337" TIME_SLOT_REF2="ts342">
                <ANNOTATION_VALUE>"Abu Ḥasan, why hast thou slain my brother?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a222"
                TIME_SLOT_REF1="ts343" TIME_SLOT_REF2="ts348">
                <ANNOTATION_VALUE>"I am not the ox" (said by Abu Ḥasan)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a223"
                TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts354">
                <ANNOTATION_VALUE>"It is he who roused the quarrel" (said by Abu Ḥasan)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a224"
                TIME_SLOT_REF1="ts355" TIME_SLOT_REF2="ts360">
                <ANNOTATION_VALUE>The panther saw the sheepskin coat which was on his shoulder.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a225"
                TIME_SLOT_REF1="ts361" TIME_SLOT_REF2="ts366">
                <ANNOTATION_VALUE>Abu Ḥasan, Wilt though make for me one like that?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a226"
                TIME_SLOT_REF1="ts367" TIME_SLOT_REF2="ts372">
                <ANNOTATION_VALUE>Abu Ḥasan answered him "I will make it</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a227"
                TIME_SLOT_REF1="ts373" TIME_SLOT_REF2="ts378">
                <ANNOTATION_VALUE>fetch me four good sheep,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a228"
                TIME_SLOT_REF1="ts379" TIME_SLOT_REF2="ts384">
                <ANNOTATION_VALUE>kill them</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a229"
                TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts390">
                <ANNOTATION_VALUE>(so) that I may make for thee a sheepskin coat."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a230"
                TIME_SLOT_REF1="ts391" TIME_SLOT_REF2="ts396">
                <ANNOTATION_VALUE>The panther betook himself, brought four sheep to him.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a231"
                TIME_SLOT_REF1="ts397" TIME_SLOT_REF2="ts402">
                <ANNOTATION_VALUE>He ate the flesh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a232"
                TIME_SLOT_REF1="ts403" TIME_SLOT_REF2="ts408">
                <ANNOTATION_VALUE>and cast the skins.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a233"
                TIME_SLOT_REF1="ts409" TIME_SLOT_REF2="ts414">
                <ANNOTATION_VALUE> in a pit</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a234"
                TIME_SLOT_REF1="ts415" TIME_SLOT_REF2="ts420">
                <ANNOTATION_VALUE>The panther came to him and said "Where is the coat, Abu Ḥasan?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a235"
                TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>He said " there lacks another sheep"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a236"
                TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts432">
                <ANNOTATION_VALUE>The panther brought him a cheep</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a237"
                TIME_SLOT_REF1="ts433" TIME_SLOT_REF2="ts438">
                <ANNOTATION_VALUE>Abu Ḥasan killed it, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a238"
                TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>ate it</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a239"
                TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>he and his children.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a240"
                TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>and cast the skin into a pit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a241"
                TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts462">
                <ANNOTATION_VALUE>The panther came to him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a242"
                TIME_SLOT_REF1="ts463" TIME_SLOT_REF2="ts468">
                <ANNOTATION_VALUE>he said, "where is the coat, Abu Ḥasan?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a243"
                TIME_SLOT_REF1="ts469" TIME_SLOT_REF2="ts474">
                <ANNOTATION_VALUE>He said "stay till I bring it"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a244"
                TIME_SLOT_REF1="ts475" TIME_SLOT_REF2="ts480">
                <ANNOTATION_VALUE>Abu Ḥasan fled</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a245"
                TIME_SLOT_REF1="ts481" TIME_SLOT_REF2="ts486">
                <ANNOTATION_VALUE>the panther followed him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a246"
                TIME_SLOT_REF1="ts487" TIME_SLOT_REF2="ts492">
                <ANNOTATION_VALUE>He betook himself and went, he enters a cave.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a247"
                TIME_SLOT_REF1="ts493" TIME_SLOT_REF2="ts498">
                <ANNOTATION_VALUE>He took him by his tail;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a248"
                TIME_SLOT_REF1="ts499" TIME_SLOT_REF2="ts504">
                <ANNOTATION_VALUE>Abu Ḥasan pulled himself (and escaped),</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a249"
                TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts510">
                <ANNOTATION_VALUE>his tail was cut in the paw of the panther. Abu Ḥasan rose from there and remained tailless.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a250"
                TIME_SLOT_REF1="ts511" TIME_SLOT_REF2="ts516">
                <ANNOTATION_VALUE>The panther said to him, "Thou art tailless, Abu Ḥasan, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a251"
                TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts522">
                <ANNOTATION_VALUE>I will know thee."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a252"
                TIME_SLOT_REF1="ts523" TIME_SLOT_REF2="ts528">
                <ANNOTATION_VALUE>Abu Ḥasan went from there,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a253"
                TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts534">
                <ANNOTATION_VALUE>the panther departed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a254"
                TIME_SLOT_REF1="ts535" TIME_SLOT_REF2="ts540">
                <ANNOTATION_VALUE>Hent to a vineyard, (ate grapes) from it. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a255"
                TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts546">
                <ANNOTATION_VALUE>(ate grapes)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a256"
                TIME_SLOT_REF1="ts547" TIME_SLOT_REF2="ts552">
                <ANNOTATION_VALUE>He gave a shout (and) all of his people came.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a257"
                TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts558">
                <ANNOTATION_VALUE>(he said) "Let us eat grapes"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a258"
                TIME_SLOT_REF1="ts559" TIME_SLOT_REF2="ts564">
                <ANNOTATION_VALUE>he made them descend into the vineyard. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a259"
                TIME_SLOT_REF1="ts565" TIME_SLOT_REF2="ts570">
                <ANNOTATION_VALUE>he said "I will not suffer you to eat unless I bind your tails"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a260"
                TIME_SLOT_REF1="ts571" TIME_SLOT_REF2="ts576">
                <ANNOTATION_VALUE>Abu Ḥasan bound them </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a261"
                TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts582">
                <ANNOTATION_VALUE>and came the watchman.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a262"
                TIME_SLOT_REF1="ts583" TIME_SLOT_REF2="ts588">
                <ANNOTATION_VALUE>He shouted in his ear</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a263"
                TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts594">
                <ANNOTATION_VALUE>The watchman rose from there, shot them with a gun</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a264"
                TIME_SLOT_REF1="ts595" TIME_SLOT_REF2="ts600">
                <ANNOTATION_VALUE>and all their tails were plucked out. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a265"
                TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself and went to the panther. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a266"
                TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts612">
                <ANNOTATION_VALUE>He said "I will seize thee, Abu Ḥasan."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a267"
                TIME_SLOT_REF1="ts613" TIME_SLOT_REF2="ts618">
                <ANNOTATION_VALUE>He said "Fellow, what dost tthou with me?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a268"
                TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts624">
                <ANNOTATION_VALUE>He said "thou has taken the sheep and eaten them</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a269"
                TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts630">
                <ANNOTATION_VALUE>and dist not make the sheepskin coat for me"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a270"
                TIME_SLOT_REF1="ts631" TIME_SLOT_REF2="ts636">
                <ANNOTATION_VALUE>he said "It is not I"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a271"
                TIME_SLOT_REF1="ts637" TIME_SLOT_REF2="ts642">
                <ANNOTATION_VALUE>He said "It is thee"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a272"
                TIME_SLOT_REF1="ts643" TIME_SLOT_REF2="ts648">
                <ANNOTATION_VALUE>He said "Who told thee that it was I?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a273"
                TIME_SLOT_REF1="ts649" TIME_SLOT_REF2="ts654">
                <ANNOTATION_VALUE>he said "I cut off thy tail"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a274"
                TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts660">
                <ANNOTATION_VALUE>He said "All my people, all my near relations, are tailless"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a275"
                TIME_SLOT_REF1="ts661" TIME_SLOT_REF2="ts666">
                <ANNOTATION_VALUE>He said "Let me see, call them"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a276"
                TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts672">
                <ANNOTATION_VALUE>Aby Ḥasan shouted to them,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a277"
                TIME_SLOT_REF1="ts673" TIME_SLOT_REF2="ts678">
                <ANNOTATION_VALUE>and they all came, the panther saw that they were all tailless. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a278"
                TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts684">
                <ANNOTATION_VALUE>he did not know which was the one who had eaten the sheep</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a279"
                TIME_SLOT_REF1="ts685" TIME_SLOT_REF2="ts690">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself and invited the panther</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a280"
                TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts696">
                <ANNOTATION_VALUE>Abu Ḥasan put a carpet on the mouth of the well</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a281"
                TIME_SLOT_REF1="ts697" TIME_SLOT_REF2="ts702">
                <ANNOTATION_VALUE>and caused the panther to sit on it</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a282"
                TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts708">
                <ANNOTATION_VALUE>and hefell into the middle of the well.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a283"
                TIME_SLOT_REF1="ts709" TIME_SLOT_REF2="ts714">
                <ANNOTATION_VALUE>The panther came from there</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a284"
                TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts720">
                <ANNOTATION_VALUE>leapt from the well,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a285"
                TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts726">
                <ANNOTATION_VALUE>siezed Abu Ḥasan and put him in the well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a286"
                TIME_SLOT_REF1="ts727" TIME_SLOT_REF2="ts732">
                <ANNOTATION_VALUE>The two were in the well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a287"
                TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts738">
                <ANNOTATION_VALUE>In two days the panther died of hunger</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a288"
                TIME_SLOT_REF1="ts739" TIME_SLOT_REF2="ts744">
                <ANNOTATION_VALUE>Abu Ḥasan ate the panther in the well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a289"
                TIME_SLOT_REF1="ts745" TIME_SLOT_REF2="ts750">
                <ANNOTATION_VALUE>There were women going to sell chickens. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a290"
                TIME_SLOT_REF1="ts751" TIME_SLOT_REF2="ts756">
                <ANNOTATION_VALUE>Their baskets were full</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a291"
                TIME_SLOT_REF1="ts757" TIME_SLOT_REF2="ts762">
                <ANNOTATION_VALUE>They saw that well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a292"
                TIME_SLOT_REF1="ts763" TIME_SLOT_REF2="ts768">
                <ANNOTATION_VALUE>The sun set on them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a293"
                TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>They slept by the well.  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a294"
                TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>They lowered the chickend into the well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a295"
                TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>They made them sleep in the well that night</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a296"
                TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>Abu Ḥasan did not leave a single chicken of them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a297"
                TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>In the morning the women raised the basket from the well. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a298"
                TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>he/Abu Ḥasan was sleeping in the basketǃ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a299"
                TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>When he got up outside, he fled</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a300"
                TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>Those women wept</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a301"
                TIME_SLOT_REF1="ts817" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>and returned, departed to their houses. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a302"
                TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself, he said</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a303"
                TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>"I want to go to the haj and cease from sin"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a304"
                TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>There was a bedawi riding a camel, going to the haj. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a305"
                TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>Abu Ḥasan seized the tail of the camel. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a306"
                TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>The bedawi looked and saw him seizing the tail of the camel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a307"
                TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>The bedawi betook himself, seized the sword, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a308"
                TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>And struck Abu Ḥasan thus, and cut the tail of his camel. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a309"
                TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Abu Ḥasan betook himself and returned.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a310"
                TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>He saw a bird on the way sleeping on its young.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311"
                TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>he came from there to eat its chilren</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312"
                TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>Don't eat my childrenǃ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313"
                TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>Abu Ḥasan said "Make me laugh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314"
                TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>She said "At what?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315"
                TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>He said "At those harvesters."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>She said "stay where you are"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317"
                TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>The bird came, sat on the head of one of the men.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a318"
                TIME_SLOT_REF1="ts919" TIME_SLOT_REF2="ts924">
                <ANNOTATION_VALUE>One man came from there, he came to strike the bird with the sickle;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a319"
                TIME_SLOT_REF1="ts925" TIME_SLOT_REF2="ts930">
                <ANNOTATION_VALUE>he cut off the head of the man. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a320"
                TIME_SLOT_REF1="ts931" TIME_SLOT_REF2="ts936">
                <ANNOTATION_VALUE>Abu Ḥasan laughed, he was contented.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a321"
                TIME_SLOT_REF1="ts937" TIME_SLOT_REF2="ts942">
                <ANNOTATION_VALUE>He rushed on the children of the bird, he went to eat them.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a322"
                TIME_SLOT_REF1="ts943" TIME_SLOT_REF2="ts948">
                <ANNOTATION_VALUE>She said "What do you want?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a323"
                TIME_SLOT_REF1="ts949" TIME_SLOT_REF2="ts954">
                <ANNOTATION_VALUE>he said "I am thirsty, I want to drink</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a324"
                TIME_SLOT_REF1="ts955" TIME_SLOT_REF2="ts960">
                <ANNOTATION_VALUE>that which a woman is carrying in a jug of water.ː"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a325"
                TIME_SLOT_REF1="ts961" TIME_SLOT_REF2="ts966">
                <ANNOTATION_VALUE>The bird stepped in front of the woman. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a326"
                TIME_SLOT_REF1="ts967" TIME_SLOT_REF2="ts972">
                <ANNOTATION_VALUE>The woman set down her jugs there,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a327"
                TIME_SLOT_REF1="ts973" TIME_SLOT_REF2="ts978">
                <ANNOTATION_VALUE>and ran to take the bird.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a328"
                TIME_SLOT_REF1="ts979" TIME_SLOT_REF2="ts983">
                <ANNOTATION_VALUE>Abu Ḥasan came, drank all her water. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="imported-sep" TIER_ID="Matras_Jerusalem_Domari_2000">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a329"
                TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>kān ikaki ṭāṭi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a330"
                TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>kān ašti nkīs di gorwe.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a331"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>kān ḥruṭkara wāšīsan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a332"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>gorwak ikak nasri.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a333"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>ṭāṭ manda gorwya ū gara kuryaka.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a334"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>sabaḥtan ta laham tōras biddī maramis ihi šaryama.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a335"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>tōr laheda ḥašīšī dirgēk ū gara. </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a336"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>manīra hnon qēyra giš ḥašīšī</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a337"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>ēra abuske abu ḥasan,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a338"
                TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>saʕlabi.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a339"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>abu ḥasan širda abuske kē karēk hnēna ya tōr, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a340"
                TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>"aha daryosi nimirki</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a341"
                TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>ta awar nimis bagari xarēr"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a342"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>abu ḥasan gara nimirke</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a343"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts92">
                <ANNOTATION_VALUE>ēra tōr ū qēra giš ḥašīšēr.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a344"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>abu ḥasan šarīra.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a345"
                TIME_SLOT_REF1="ts99" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>nimir ēra,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a346"
                TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>širda "tōraske kēkē manīror hnēna ḥašīšma?"</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a347"
                TIME_SLOT_REF1="ts111" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>ṣāḥbom kull ḥīn kamkari ʕankīm ū ama tʕibahrom.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a348"
                TIME_SLOT_REF1="ts117" TIME_SLOT_REF2="ts122">
                <ANNOTATION_VALUE>ū ama bkarahrom.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a349"
                TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>lakedom aha maṭraḥī ērom</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a350"
                TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>ū hassaʕ ama bēn xastērki."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a351"
                TIME_SLOT_REF1="ts135" TIME_SLOT_REF2="ts140">
                <ANNOTATION_VALUE>ama kunt biddī qumnam ehnēna.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a352"
                TIME_SLOT_REF1="ts141" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>tōr manīra hnon ʕašart iyyām.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a353"
                TIME_SLOT_REF1="ts147" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>ēra abuske abu ḥasan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a354"
                TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>tōr širda abuske kē hra?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a355"
                TIME_SLOT_REF1="ts159" TIME_SLOT_REF2="ts164">
                <ANNOTATION_VALUE>abu ḥasan širda: </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a356"
                TIME_SLOT_REF1="ts165" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>"nimer mandosir aha maṭraḥma, </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a357"
                TIME_SLOT_REF1="ts171" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>ū atu nṣuḥhok,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a358"
                TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>awari nimer mararri dafrēsma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a359"
                TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts188">
                <ANNOTATION_VALUE>atu maršēk ū nimer qumnarri.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a360"
                TIME_SLOT_REF1="ts189" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>sin la awar aburke nimer,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a361"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts200">
                <ANNOTATION_VALUE>atu fumnēs qrūnērma."</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a362"
                TIME_SLOT_REF1="ts201" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>gara abu ḥasan nimirke,</ANNOTATION_VALUE>
